---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

import FormattedDate from '../components/FormattedDate.astro';
import IngredientList from '../components/IngredientList.astro';
import RecipeStep from '../components/RecipeStep.astro';
import BaseLayout from './BaseLayout.astro';

type Props = CollectionEntry<'recipes'>['data'];

const {
  title,
  description,
  time,
  servings,
  price,
  cover,
  date,
  ingredients,
  instructions
} = Astro.props;
---

<BaseLayout {title} {description}>
  <main>
    <article>
      <figure>
        <Image width={680} height={340} src={cover} alt={title} />
      </figure>
      <recipe-content>
        <recipe-header>
          <h1>{title}</h1>
          <p>{description}</p>
          <p>Posted at <FormattedDate {date} /></p>
          <recipe-price>{price}</recipe-price>
          <recipe-stats>
            <dt>Time</dt>
            <dd>{time}</dd>
            <dt>Servings</dt>
            <dd>{servings}</dd>
          </recipe-stats>
        </recipe-header>
        <section id="instructions">
          <IngredientList {ingredients} />
          <h2>Instructions</h2>
          {
            instructions.map((instruction, index) => (
              <RecipeStep step={index + 1} {instruction} />
            ))
          }
          <slot />
        </section>
      </recipe-content>
    </article>
  </main>
</BaseLayout>

<style>
  main {
    article {
      figure {
        width: 800px;
        max-width: calc(100% - 2em);
        margin: 0 auto;
        max-height: 400px;
        overflow: hidden;
        border-radius: 8px;

        img {
          display: block;
          width: 100%;
          height: 100%;
          object-fit: cover;
        }
      }

      recipe-content {
        display: block;
        width: 800px;
        max-width: calc(100% - 2em);
        margin: auto;
        padding: 2em 1em;
        color: rgb(var(--gray-dark));

        recipe-header {
          display: block;
          text-align: center;
          margin-bottom: 2em;

          h1 {
            margin: 0 0 0.5em 0;
            font-size: 2.5rem;
          }

          p {
            font-size: 1.1rem;
            color: rgb(var(--gray));
            margin-bottom: 0.5em;

            &:has(time) {
              font-size: 1rem;
              margin-bottom: 1.5em;
            }
          }

          recipe-price {
            display: inline-block;
            background: var(--accent);
            color: white;
            padding: 0.5rem 1rem;
            border-radius: 4px;
            font-weight: 500;
            margin-bottom: 1em;
          }

          recipe-stats {
            display: grid;
            grid-template-columns: repeat(2, auto);
            grid-template-rows: auto auto;
            justify-content: center;
            column-gap: 3rem;
            row-gap: 0.5rem;
            margin-bottom: 1.5em;
            padding: 1.5em;
            background: var(--gray-light);
            border-radius: 8px;

            dt {
              font-size: 1rem;
              color: rgb(var(--gray));
              text-align: center;
              font-weight: 500;
              grid-row: 1;
            }

            dd {
              font-size: 1.5rem;
              font-weight: bold;
              color: rgb(var(--black));
              text-align: center;
              margin: 0;
              grid-row: 2;
            }
          }
        }

        #instructions {
          margin-top: 2em;

          h2 {
            font-size: 1.5rem;
            margin-bottom: 1rem;
            color: rgb(var(--black));
          }
        }
      }
    }
  }
</style>
