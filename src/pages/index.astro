---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <main>
    <section id="hero">
      <h1>Simple Recipes</h1>
      <p>Easy-to-follow recipes with simple ingredients.</p>
      <a href="/recipes">Browse recipes</a>
    </section>

    <section id="features">
      <article>
        <span>🍳</span>
        <h2>Simple</h2>
        <p>Straightforward recipes using basic ingredients.</p>
      </article>
      <article>
        <span>⏱️</span>
        <h2>Quick</h2>
        <p>Most recipes ready in under an hour from start to finish.</p>
      </article>
    </section>
  </main>
</BaseLayout>

<style>
  main {
    margin: 0 auto;
    padding: 3rem 1rem;

    #hero {
      text-align: center;
      margin-bottom: 3rem;

      h1 {
        font-size: 3rem;
        margin-bottom: 1rem;
        color: rgb(var(--black));
      }

      p {
        font-size: 1.3rem;
        color: rgb(var(--gray));
        margin-bottom: 2rem;
      }

      a {
        display: inline-block;
        background: var(--accent);
        color: white;
        padding: 1rem 2rem;
        border-radius: 8px;
        text-decoration: none;
        font-weight: bold;
        font-size: 1.1rem;
      }
    }

    #features {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 2rem;
      margin-top: 4rem;

      article {
        text-align: center;
        padding: 1.5rem;

        span {
          font-size: 3rem;
        }

        h2 {
          font-size: 1.5rem;
          margin: 1rem 0 0.5rem 0;
        }
      }
    }

    @media (max-width: 768px) {
      #features {
        grid-template-columns: 1fr;
        margin-top: 2rem;
      }
    }
  }
</style>
